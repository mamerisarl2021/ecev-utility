[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/usr/src/ecev-utility/app
ExecStart=/usr/src/ecev-utility/venv/bin/gunicorn --workers 3 --log-level debug --error-logfile /usr/src/ecev-utility/error.log --bind 0.0.0.0:7000 app.wsgi:application

[Install]
WantedBy=multi-user.target